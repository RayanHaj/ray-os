{
    "parser": "vue-eslint-parser",  // Use Vue-specific parser
    "parserOptions": {
        "ecmaVersion": 2020,
        "sourceType": "module"
    },
    "extends": [
        "eslint:recommended",
        "plugin:vue/vue3-recommended"
    ],
    "plugins": [
        "vue"
    ],
    "rules": {
        "no-unused-vars": [
            "error",
            {
                "argsIgnorePattern": "^_$"  // Ignore unused _ variables
            }
        ]
    }
}
